from collections import defaultdict

class Excel:

    def __init__(self, height: int, width: char):
        self.height = height
        self.width = ord(width) - ord('A') + 1
        self.grid = [[0] * (self.width + 1) for _ in range(self.height + 1)]
        self.formulas = {}

    def set(self, row: int, column: str, val: int) -> None:
        col = ord(column) - ord('A') + 1
        if (row, col) in self.formulas:
            del self.formulas[(row, col)]
        self.grid[row][col] = val

    def get(self, row: int, column: str) -> int:
        col = ord(column) - ord('A') + 1
        if (row, col) in self.formulas:
            return self._eval(row, col)
        return self.grid[row][col]

    def sum(self, row: int, column: str, numbers: List[str]) -> int:
        col = ord(column) - ord('A') + 1
        self.formulas[(row, col)] = numbers
        return self.get(row, column)

    def _eval(self, row: int, col: int) -> int:
        total = 0
        for s in self.formulas[(row, col)]:
            if ":" not in s:
                r, c = self._parse(s)
                total += self.get(r, c)
            else:
                top_left, bottom_right = s.split(":")
                r1, c1 = self._parse(top_left)
                r2, c2 = self._parse(bottom_right)
                for r in range(r1, r2 + 1):
                    for c in range(c1, c2 + 1):
                        total += self.get(r, c)
        return total

    def _parse(self, s: str) -> tuple:
        return int(s[1:]), ord(s[0]) - ord('A') + 1
