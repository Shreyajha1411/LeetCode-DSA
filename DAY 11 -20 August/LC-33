class Solution:
    def numIslands(self, grid: list[list[str]]) -> int:
        if not grid:
            return 0
            
        rows, cols = len(grid), len(grid[0])
        island_count = 0
        
        def dfs(r: int, c: int):
            # Base Case: Out of grid boundaries or cell is water ('0')
            if r < 0 or r >= rows or c < 0 or c >= cols or grid[r][c] == "0":
                return
                
            # Sink the current land cell to avoid infinite loops and recounting
            grid[r][c] = "0"
            
            # Recursively visit all 4 adjacent directions (Up, Down, Left, Right)
            dfs(r + 1, c) # Down
            dfs(r - 1, c) # Up
            dfs(r, c + 1) # Right
            dfs(r, c - 1) # Left

        # Iterate through every cell in the 2D grid matrix
        for r in range(rows):
            for c in range(cols):
                if grid[r][c] == "1":
                    # Found a new island, start the traversal to sink it
                    island_count += 1
                    dfs(r, c)
                    
        return island_count
