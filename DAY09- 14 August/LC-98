from typing import Optional

# Definition for a binary tree node.
class TreeNode:
    def __init__(self, val=0, left=None, right=None):
        self.val = val
        self.left = left
        self.right = right

class Solution:
    def isValidBST(self, root: Optional[TreeNode]) -> bool:
        
        def validate(node: Optional[TreeNode], low: float, high: float) -> bool:
            # An empty tree node is a valid BST base case
            if not node:
                return True
                
            # Current node value must fall strictly within the inherited boundaries
            if not (low < node.val < high):
                return False
                
            # Validate left child (updates upper limit) and right child (updates lower limit)
            return validate(node.left, low, node.val) and validate(node.right, node.val, high)
            
        # Initialize the check with negative and positive infinity boundaries
        return validate(root, float('-inf'), float('inf'))
