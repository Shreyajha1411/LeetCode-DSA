from typing import Optional

# Definition for a binary tree node.
class TreeNode:
    def __init__(self, val=0, left=None, right=None):
        self.val = val
        self.left = left
        self.right = right

class Solution:
    def diameterOfBinaryTree(self, root: Optional[TreeNode]) -> int:
        self.max_diameter = 0
        
        def calculate_depth(node: Optional[TreeNode]) -> int:
            if not node:
                return 0
            
            # Step 1: Recursively find the depth of left and right subtrees
            left_depth = calculate_depth(node.left)
            right_depth = calculate_depth(node.right)
            
            # Step 2: Update the global maximum diameter found so far
            # The path through the current node uses (left_depth + right_depth) edges
            self.max_diameter = max(self.max_diameter, left_depth + right_depth)
            
            # Step 3: Return the depth of the current subtree back up to the parent
            return 1 + max(left_depth, right_depth)
            
        calculate_depth(root)
        return self.max_diameter
