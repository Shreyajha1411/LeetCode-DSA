from typing import Optional

# Definition for a Node.
class Node:
    def __init__(self, val, prev=None, next=None, child=None):
        self.val = val
        self.prev = prev
        self.next = next
        self.child = child

class Solution:
    def flatten(self, head: Optional['Node']) -> Optional['Node']:
        if not head:
            return None
            
        curr = head
        stack = []
        
        while curr:
            # Case 1: Node has a child pointer branch
            if curr.child:
                # If there's a next node in the main level, save it for later
                if curr.next:
                    stack.append(curr.next)
                    
                # Bridge current node to its child
                curr.next = curr.child
                curr.child.prev = curr
                
                # Clear the child pointer as required by the flattened format
                curr.child = None
            
            # Case 2: Reached the end of the current branch segment, but stack has saved nodes
            elif not curr.next and stack:
                next_node = stack.pop()
                
                # Connect the end of this level segment back to the popped node
                curr.next = next_node
                next_node.prev = curr
                
            # Move forward along the newly linked sequence
            curr = curr.next
            
        return head
