class Solution:
    def findUnsortedSubarray(self, nums: list[int]) -> int:
        n = len(nums)
        if n <= 1:
            return 0
            
        # Pointers to track the boundaries of the unsorted subarray
        end = -1
        start = 0
        
        # Track max from the left and min from the right
        max_seen = float('-inf')
        min_seen = float('inf')
        
        # Pass 1 & 2: Traversal combined into a single loop
        for i in range(n):
            # From left to right: update max and find the rightmost out-of-order element
            max_seen = max(max_seen, nums[i])
            if nums[i] < max_seen:
                end = i
                
            # From right to left: update min and find the leftmost out-of-order element
            j = n - 1 - i
            min_seen = min(min_seen, nums[j])
            if nums[j] > min_seen:
                start = j
                
        # If 'end' pointer was never updated, the array is already sorted
        if end == -1:
            return 0
            
        return end - start + 1
