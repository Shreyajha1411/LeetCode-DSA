class Solution:
    def intervalIntersection(self, firstList: list[list[int]], secondList: list[list[int]]) -> list[list[int]]:
        i, j = 0, 0
        result = []
        
        while i < len(firstList) and j < len(secondList):
            # Step 1: Find the overlapping interval boundaries
            # The start of the intersection is the max of the two starts
            start = max(firstList[i][0], secondList[j][0])
            # The end of the intersection is the min of the two ends
            end = min(firstList[i][1], secondList[j][1])
            
            # Step 2: If the interval is valid, add it to the result
            if start <= end:
                result.append([start, end])
                
            # Step 3: Advance the pointer of the interval that ends first
            if firstList[i][1] < secondList[j][1]:
                i += 1
            else:
                j += 1
                
        return result
