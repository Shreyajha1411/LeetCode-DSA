class Solution:
    def minSubArrayLen(self, target: int, nums: list[int]) -> int:
        n = len(nums)
        min_length = float('inf')
        current_sum = 0
        left = 0
        
        # Expand the window using the right pointer
        for right in range(n):
            current_sum += nums[right]
            
            # Shrink the window from the left as long as the condition is satisfied
            while current_sum >= target:
                # Update the minimal window length found so far
                min_length = min(min_length, right - left + 1)
                
                # Subtract the element exiting the window and move left pointer
                current_sum -= nums[left]
                left += 1
                
        # If min_length was never updated, no valid subarray exists
        return min_length if min_length != float('inf') else 0
